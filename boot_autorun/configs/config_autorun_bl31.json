{
    "_comment": "============================================",
    "_description": "启动各阶段自动运行框架 - BL31阶段配置",
    "_version": "1.0.0",
    "_author": "AutoRun Framework",
    "============================================": "",
    "config_meta": {
        "version": 1,
        "magic": "0xA55A5AA5",
        "description": "SoC启动自动化测试 - BL31阶段配置",
        "created_time": "2026-01-01T00:00:00Z",
        "modified_time": "2026-01-01T00:00:00Z",
        "creator": "test_engineer",
        "target_soc": "MySOC-1000"
    },
    "global_config": {
        "log_level": 3,
        "_log_level_desc": "0=OFF, 1=ERROR, 2=WARN, 3=INFO, 4=DEBUG",
        "global_timeout_s": 300,
        "_timeout_desc": "全局超时时间(秒), 0表示无限制",
        "continue_on_error": false,
        "_continue_desc": "非关键任务失败时是否继续执行后续任务",
        "result_output_addr": "0x12340000",
        "_result_addr_desc": "结果输出内存地址(物理地址)",
        "result_max_size": 8192,
        "_result_size_desc": "结果区域最大大小(bytes)",
        "halt_on_completion": false,
        "_halt_desc": "全部任务完成后是否停机/进入死循环(便于读取结果)"
    },
    "stages": {
        "bl31": {
            "enabled": true,
            "_stage_desc": "BL31阶段: 安全监控、PSCI、SMC调用测试",
            "execution_order": 2,
            "tasks": [
                {
                    "id": 1000,
                    "name": "psci_version_check",
                    "command": "smc_call 0x84000000",
                    "enabled": true,
                    "critical": true,
                    "timeout_ms": 2000,
                    "retry_count": 0,
                    "retry_delay_ms": 0,
                    "expected_result": {
                        "type": "range",
                        "min_val": 0,
                        "max_val": 2
                    },
                    "log_output": true,
                    "_desc": "PSCI版本检查, 返回值应在0-2范围"
                },
                {
                    "id": 1001,
                    "name": "smc_cpu_on_test",
                    "command": "smc_cpu_on --cpu_id 1 --entry_addr 0x80000",
                    "enabled": true,
                    "critical": false,
                    "timeout_ms": 5000,
                    "retry_count": 1,
                    "retry_delay_ms": 1000,
                    "expected_result": {
                        "type": "return_code",
                        "value": 0
                    },
                    "log_output": true
                },
                {
                    "id": 1002,
                    "name": "trustzone_register_check",
                    "command": "tz_check --scr_el3 --sctlr_el3",
                    "enabled": true,
                    "critical": true,
                    "timeout_ms": 3000,
                    "retry_count": 0,
                    "retry_delay_ms": 0,
                    "expected_result": {
                        "type": "checksum",
                        "algorithm": "crc32",
                        "expected_value": "0xDEADBEEF"
                    },
                    "log_output": true
                }
            ]
        }
    },
    "custom_properties": {
        "project_name": "MySOC_FullBootTest_v1.2",
        "test_environment": "EVT Board Rev1.0",
        "firmware_versions": {
            "bl1": "v1.0.3",
            "bl31": "v2.1.0",
            "rtthread": "v4.0.2",
            "uboot": "2021.10-custom",
            "linux": "5.15.62-lts"
        },
        "hardware_config": {
            "ddr_size": "2GB",
            "ddr_type": "LPDDR4X-3200",
            "emmc_size": "64GB",
            "display": "1920x1080@60Hz",
            "network": "1Gbps Ethernet + WiFi6"
        },
        "notification": {
            "on_complete": {
                "method": "gpio_pulse",
                "pin": "PA15",
                "duration_ms": 100,
                "_desc": "测试完成后通过GPIO脉冲通知外部设备"
            },
            "on_failure": {
                "method": "uart_message",
                "message_pattern": "[AUTORUN_FAIL] task_id=%d task_name=%s error_code=%d"
            }
        },
        "current_stage": "bl31",
        "stage_description": "BL31阶段: 安全监控、PSCI、SMC调用测试"
    }
}
